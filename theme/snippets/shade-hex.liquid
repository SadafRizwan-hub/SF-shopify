{%- comment -%}
  Usage: {% render 'shade-hex', name: value %}
  Echoes the hex for a shade name. An unlisted shade is not an error — it
  falls back to the neutral swatch so the shopper still reads the name.
{%- endcomment -%}
{%- liquid
  capture table
    render 'shade-table'
  endcapture

  assign wanted = name | handle
  assign found = settings.unknown_shade

  assign pairs = table | split: ','
  for pair in pairs
    assign kv = pair | strip | split: ':'
    if kv[0] == wanted
      assign found = kv[1]
      break
    endif
  endfor

  echo found
-%}
