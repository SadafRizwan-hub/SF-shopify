# Copy to .env and fill in. .env is git-ignored.
# Storefront API token is public/read-scoped — safe in frontend code.
# NEVER put an Admin API token in here.

NUXT_PUBLIC_SHOPIFY_DOMAIN=yourstore.myshopify.com
NUXT_PUBLIC_SHOPIFY_TOKEN=your-storefront-access-token

# Optional — defaults to 2025-10 if unset.
# NUXT_PUBLIC_SHOPIFY_API_VERSION=2025-10
