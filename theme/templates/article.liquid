<div class="shell prose">
  <header class="top">
    <span class="label">{{ article.published_at | date: '%d %b %Y' }}</span>
    <h1>{{ article.title }}</h1>
  </header>
  {%- if article.image -%}
    <div class="strip" style="grid-template-columns: 1fr;">
      {{ article.image | image_url: width: 1600 | image_tag: alt: article.title, sizes: '100vw', widths: '600,900,1200,1600' }}
    </div>
  {%- endif -%}
  <div class="rte" style="max-width: 64ch;">{{ article.content }}</div>
</div>
