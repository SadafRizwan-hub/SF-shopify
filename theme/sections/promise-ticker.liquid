{%- comment -%}
  The promise band: a thin strip under the banner — small line icons, each
  with a short promise (Made in India, Cash on Delivery, 7 Day Returns…) —
  that drifts slowly sideways like a ticker.

  Each promise is a block (Customize → Promise band → Add promise): an icon
  from snippets/promise-icon (the same drawings as Why shop with us), a short
  title, an optional few words after it, and an optional link.

  The list is drawn twice and the track slides by exactly one copy, so the
  loop has no seam; the second copy is hidden from screen readers and taken
  out of the tab order. It pauses under the pointer and while a link in it
  has focus, and stands still — as a centred row that scrolls by hand if it
  does not fit — when "Move" is off or the device asks for reduced motion.
  Styles live in this file, so it is one file to copy into a theme.
{%- endcomment -%}
{%- assign items = section.blocks | where: 'type', 'promise' -%}
{%- if items.size > 0 -%}
  {%- capture strip -%}
    {%- for block in items -%}
      {%- if block.settings.link != blank -%}
        <a class="tick" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
      {%- else -%}
        <span class="tick" {{ block.shopify_attributes }}>
      {%- endif -%}
        <span class="tick-icon" aria-hidden="true">{% render 'promise-icon', name: block.settings.icon %}</span>
        <span class="tick-text">
          <b>{{ block.settings.title }}</b>
          {%- if block.settings.text != blank %} <span>{{ block.settings.text }}</span>{% endif -%}
        </span>
      {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
      <span class="tick-leaf" aria-hidden="true">{% render 'promise-icon', name: 'leaf' %}</span>
    {%- endfor -%}
  {%- endcapture -%}

  <section class="ticker{% if section.settings.move %} ticker--move{% endif %} ticker--{{ section.settings.background }}"
           style="--tick-speed: {{ section.settings.speed | times: items.size }}s;" aria-label="{{ section.settings.label | default: 'Our promises' | escape }}">
    <div class="ticker-track">
      <div class="ticker-set">{{ strip }}</div>
      {%- if section.settings.move -%}
        {%- comment -%} the seamless loop's second copy: seen, not read or tabbed to {%- endcomment -%}
        <div class="ticker-set" aria-hidden="true" inert>{{ strip }}</div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .ticker {
    overflow: hidden; border-bottom: 1px solid rgba(150, 112, 46, 0.18);
    background: var(--paper, #f8f5ef);
  }
  .ticker--sand { background: var(--sand, #efe8dc); }
  .ticker--ink { background: #14110f; }
  .ticker--ink .tick, .ticker--ink .tick-icon { color: #f3e9d6; }
  .ticker--ink .tick-text span { color: rgba(243, 233, 214, 0.7); }

  .ticker-track { display: flex; width: max-content; }
  .ticker-set { display: flex; align-items: center; flex-shrink: 0; }

  .tick {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 13px 26px; white-space: nowrap; color: var(--ink);
  }
  a.tick:hover b { text-decoration: underline; text-underline-offset: 3px; }
  .tick-icon { display: inline-flex; color: var(--ink); }
  /* the drawings are made for 72px; at band size their lines need weight */
  .tick-icon svg { width: 30px; height: 30px; stroke-width: 2.4px; }
  .tick-text { font-size: 14.5px; letter-spacing: 0.3px; }
  .tick-text b { font-family: var(--serif); font-size: 19px; font-weight: 500; }
  .tick-text span { color: var(--ink-70); }
  .tick-leaf { display: inline-flex; color: var(--brass, #96702e); opacity: 0.85; }
  .tick-leaf svg { width: 16px; height: 16px; transform: rotate(180deg); }

  /* moving: slide by one copy and loop; pause under the pointer or focus */
  .ticker--move .ticker-track { animation: ticker-slide var(--tick-speed, 40s) linear infinite; }
  .ticker--move:hover .ticker-track,
  .ticker--move:focus-within .ticker-track { animation-play-state: paused; }
  @keyframes ticker-slide { to { transform: translateX(-50%); } }

  /* still: a centred row, scrolled by hand when it does not fit */
  .ticker:not(.ticker--move) .ticker-track { width: auto; overflow-x: auto; scrollbar-width: none; }
  .ticker:not(.ticker--move) .ticker-track::-webkit-scrollbar { display: none; }
  .ticker:not(.ticker--move) .ticker-set { margin-inline: auto; }
  .ticker:not(.ticker--move) .tick-leaf:last-child { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .ticker--move .ticker-track { animation: none; width: auto; overflow-x: auto; scrollbar-width: none; }
    .ticker--move .ticker-set[aria-hidden] { display: none; }
    .ticker--move .ticker-set { margin-inline: auto; }
    .ticker--move .tick-leaf:last-child { display: none; }
  }

  @media (max-width: 700px) {
    .tick { padding: 10px 16px; gap: 9px; }
    .tick-icon svg { width: 24px; height: 24px; stroke-width: 2.8px; }
    .tick-text { font-size: 13px; }
    .tick-text b { font-size: 16.5px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promise band",
  "max_blocks": 10,
  "settings": [
    { "type": "checkbox", "id": "move", "label": "Slide slowly like a ticker", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per promise", "min": 3, "max": 15, "step": 1, "default": 7, "info": "Higher is slower." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "plain",
      "options": [
        { "value": "plain", "label": "Page colour" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Dark" }
      ]
    },
    { "type": "text", "id": "label", "label": "Name for screen readers", "default": "Our promises" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "quality",
          "options": [
            { "value": "india", "label": "Map of India" },
            { "value": "quality", "label": "Quality badge" },
            { "value": "cod", "label": "Wallet (cash on delivery)" },
            { "value": "shipping", "label": "Delivery truck" },
            { "value": "returns", "label": "Return arrow" },
            { "value": "fabric", "label": "Fabric" },
            { "value": "whatsapp", "label": "Chat" }
          ]
        },
        { "type": "text", "id": "title", "label": "Promise", "default": "Assured Quality" },
        { "type": "text", "id": "text", "label": "A few words after it (optional)", "info": "e.g. on all qualifying orders. Keep it short." },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promise band",
      "blocks": [
        { "type": "promise", "settings": { "icon": "india", "title": "Made in India" } },
        { "type": "promise", "settings": { "icon": "quality", "title": "Assured Quality" } },
        { "type": "promise", "settings": { "icon": "cod", "title": "Cash on Delivery" } },
        { "type": "promise", "settings": { "icon": "shipping", "title": "Free Shipping Over ₹849" } },
        { "type": "promise", "settings": { "icon": "returns", "title": "7 Day Returns" } }
      ]
    }
  ]
}
{% endschema %}
