{%- comment -%}
  The homepage banner: a slideshow the counter runs from the theme editor.

  Each slide is a block — Customize → Banner → Add slide — with its own
  photograph, a short label (New arrival, Offer), a heading, a button and where
  the button goes. Pick a fabric on a slide and the slide fills its own gaps
  from it: the fabric's photograph when no image is uploaded, its name when no
  heading is typed, its page when no link is given. Slides can be reordered,
  hidden and removed there too, so the banner changes without touching code.

  With no slides added, one automatic slide leads with the newest fabric that
  has a photograph, as the banner always did — now with only its name and a
  button. An empty shelf with no slides shows the shop's heading on an ink
  ground, never a call to action for stock that doesn't exist.

  More than one slide turns on the arrows, the dots and (optionally) autoplay.
  The track is a native horizontal scroller, so it swipes on a phone before any
  script runs; hero-slides.js only drives it. Autoplay stops for good once the
  shopper touches a control, pauses while the pointer or focus is on it, and
  never runs for someone who asked their system for reduced motion.
{%- endcomment -%}
{%- liquid
  assign unit = settings.cut_unit_metres | times: 1.0
  assign factor = 1 | divided_by: unit

  assign slides = section.blocks | where: 'type', 'slide'
  assign shown = 0
  for block in slides
    if block.settings.image != blank or block.settings.product.featured_image != blank
      assign shown = shown | plus: 1
    endif
  endfor

  if shown == 0
    # the automatic slide: the newest fabric that has a photograph
    assign items = collections.all.products | sort: 'created_at' | reverse
    assign lead = nil
    for candidate in items
      if candidate.featured_image
        assign lead = candidate
        break
      endif
    endfor
    if lead == nil
      assign lead = items.first
    endif
    capture lead_fresh
      render 'is-new', product: lead
    endcapture
  endif

  assign height = section.settings.height | default: 'medium'
  assign drawn = 0
-%}
<section class="hero hero--{{ height }}" data-hero
  {%- if shown > 1 and section.settings.autoplay %} data-autoplay="{{ section.settings.speed | times: 1000 }}"{% endif %}
  aria-roledescription="carousel" aria-label="{{ section.settings.label | default: 'Featured fabrics' | escape }}">

  <div class="slides" data-hero-track>
    {%- if shown > 0 -%}
      {%- for block in slides -%}
        {%- liquid
          assign fabric = block.settings.product
          assign picture = block.settings.image | default: fabric.featured_image
          if picture == blank
            continue
          endif
          assign heading = block.settings.heading | default: fabric.title
          assign href = block.settings.link | default: fabric.url
          assign label = block.settings.button_label
          if label == blank and href != blank
            assign label = 'Shop now'
          endif
          # the first slide is the one seen on arrival: its photo loads at
          # once and its heading is the page's h1; the rest wait their turn
          assign drawn = drawn | plus: 1
          assign load = 'lazy'
          assign priority = ''
          assign htag = 'h2'
          if drawn == 1
            assign load = 'eager'
            assign priority = 'high'
            assign htag = 'h1'
          endif
        -%}
        <div class="slide" id="Slide-{{ block.id }}" {{ block.shopify_attributes }}
             role="group" aria-roledescription="slide" aria-label="{{ drawn }} of {{ shown }}">
          {% render 'responsive-img',
            image: picture,
            alt: heading | default: shop.name,
            sizes: '100vw',
            loading: load,
            fetchpriority: priority,
            class: 'wide' %}
          {%- if block.settings.image_mobile != blank -%}
            {% render 'responsive-img',
              image: block.settings.image_mobile,
              alt: heading | default: shop.name,
              sizes: '100vw',
              loading: 'lazy',
              class: 'narrow' %}
          {%- endif -%}
          <div class="veil{% if block.settings.image_mobile != blank %} split{% endif %}"></div>
          <div class="shell copy">
            {%- if block.settings.tag != blank -%}<span class="eyebrow">{{ block.settings.tag }}</span>{%- endif -%}
            {%- if heading != blank -%}<{{ htag }} class="h1">{{ heading }}</{{ htag }}>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="lede">{{ block.settings.text }}</p>{%- endif -%}
            {%- if href != blank -%}
              <div class="cta">
                <a class="btn btn-primary" href="{{ href }}">
                  {{- label -}}
                  {%- if block.settings.show_price and fabric != blank %} &middot; {{ fabric.price | times: factor | round | money }}/m{% endif -%}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}

    {%- elsif lead -%}
      <div class="slide{% unless lead.featured_image %} bare{% endunless %}">
        {%- if lead.featured_image -%}
          {% render 'responsive-img',
            image: lead.featured_image,
            alt: lead.title,
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'wide' %}
        {%- endif -%}
        <div class="veil"></div>
        <div class="shell copy">
          {%- if lead_fresh == 'new' and section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h1 class="h1">{{ lead.title }}</h1>
          <div class="cta">
            <a class="btn btn-primary" href="{{ lead.url }}">
              Shop now &middot; {{ lead.price | times: factor | round | money }}/m
            </a>
          </div>
        </div>
      </div>

    {%- else -%}
      <div class="slide bare">
        <div class="shell copy">
          <h1 class="h1">{{ section.settings.empty_heading | default: 'Wholesale cloth, cut to your metre' }}</h1>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if shown > 1 -%}
    <button type="button" class="heroarrow prev" data-hero-prev aria-label="Previous slide">{% render 'icon', name: 'back', size: 16 %}</button>
    <button type="button" class="heroarrow next" data-hero-next aria-label="Next slide">{% render 'icon', name: 'forward', size: 16 %}</button>
    <div class="herodots" role="group" aria-label="Choose a slide">
      {%- for i in (1..shown) -%}
        <button type="button" class="herodot{% if forloop.first %} on{% endif %}" data-hero-dot="{{ forloop.index0 }}"
                aria-label="Slide {{ i }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{%- comment -%} in the theme editor a second slide can arrive without a page load {%- endcomment -%}
{%- if shown > 1 or request.design_mode -%}
  <script src="{{ 'hero-slides.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Banner",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Add a slide for each fabric, new arrival or offer you want on the banner. With no slides, the banner shows your newest fabric by itself."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Move to the next slide by itself",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "text",
      "id": "label",
      "label": "Name for screen readers",
      "default": "Featured fabrics"
    },
    {
      "type": "header",
      "content": "With no slides added"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label while the newest fabric is new",
      "info": "Shown only while it is inside Theme settings → The counter → New for.",
      "default": "New arrival"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading when the shop has no fabric yet",
      "default": "Wholesale cloth, cut to your metre"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "A wide photo, at least 1800 px across. Leave empty to use the fabric's own photo."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image on phones (optional)",
          "info": "A tall photo for narrow screens. Without one, phones show the image above, cropped."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Fabric (optional)",
          "info": "Fills the image, heading and link from this fabric wherever you leave them empty."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Label",
          "info": "A word or two above the heading, e.g. New arrival, Offer, 20% off."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Keep it short. Leave empty to use the fabric's name."
        },
        {
          "type": "text",
          "id": "text",
          "label": "One line under the heading (optional)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link",
          "info": "A fabric, a collection or any page. Leave empty to open the fabric picked above."
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show the fabric's rate on the button",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
