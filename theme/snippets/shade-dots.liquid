{%- comment -%}
  The shade dots under a card.

  Read-only by default. Pass `images` — the card's shade-to-photograph map,
  as the JSON body fabric-card builds — and each shade that HAS a photograph
  becomes a button that swaps the card's picture where it stands, with no
  page load. A shade with no photograph of its own stays a plain dot: there
  is nothing for it to show, and a control that does nothing when pressed is
  worse than no control.

  Usage: {% render 'shade-dots', values: 'Indigo,Rust', max: 4 %}
         {% render 'shade-dots', values: v, max: 4, images: map, active: 'rust' %}

  Pass `product` and each dot takes the swatch colour picked in the admin.
{%- endcomment -%}
{%- liquid
  assign max = max | default: 4
  assign list = values | split: ','
  assign rest = list.size | minus: max
-%}
{%- if list.size > 0 -%}
  <div class="dots"{% if images != blank %} data-card-dots{% endif %}>
    {%- for value in list limit: max -%}
      {%- liquid
        assign name = value | strip
        assign slug = name | handle
        capture hex
          render 'shade-hex', name: name, product: product
        endcapture
        assign probe = '"' | append: slug | append: '"'
        assign pickable = false
        if images != blank and images contains probe
          assign pickable = true
        endif
      -%}
      {%- if pickable -%}
        <button
          type="button"
          class="dot{% if slug == active %} on{% endif %}"
          style="background: {{ hex | strip }};"
          data-card-shade="{{ slug }}"
          aria-pressed="{% if slug == active %}true{% else %}false{% endif %}"
          title="{{ name | escape }}"
        ><span class="visually-hidden">{{ name }}</span></button>
      {%- else -%}
        <span class="dot" style="background: {{ hex | strip }};" title="{{ name | escape }}"></span>
      {%- endif -%}
    {%- endfor -%}
    {%- if rest > 0 -%}<span class="more">+{{ rest }} shades</span>{%- endif -%}
  </div>
{%- endif -%}
