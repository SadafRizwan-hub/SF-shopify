<section class="shell homeband">
  <div class="promise">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <span class="label">{{ block.settings.eyebrow }}</span>
        <h3>{{ block.settings.heading }}</h3>
        {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Counter promise",
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Counter promise",
      "blocks": [
        {
          "type": "promise",
          "settings": {
            "eyebrow": "Wholesale rates on",
            "heading": "Slab pricing past 10 metres",
            "body": "The rate drops on the whole cut."
          }
        },
        {
          "type": "promise",
          "settings": {
            "eyebrow": "Swatch first",
            "heading": "Swatch before you commit",
            "body": "Order the shade card first."
          }
        },
        {
          "type": "promise",
          "settings": {
            "eyebrow": "Cut to order",
            "heading": "Half-metre increments",
            "body": "Dispatched the same evening."
          }
        }
      ]
    }
  ]
}
{% endschema %}
