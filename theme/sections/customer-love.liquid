{%- comment -%}
  Happy customers: the shop's Google rating and a row of reviews.

  Google reviews cannot be fetched without an app or an API key, so the
  rating, the link to the Google listing and each review are typed in the
  theme editor (Customize → Happy customers → Add review). They must be real
  reviews by real customers: the theme ships none, and the section stays off
  the live site until something real is added. In the theme editor, empty
  slots show as outlined placeholders so the layout can be seen while it is
  being filled.

  A long review shows its first four lines with Read more; the button only
  appears when the text actually runs past four lines, and Show less folds it
  back. Customer videos live in the View & Shop section.

  Styles and script live in this file, so it is one file to copy into a theme.
{%- endcomment -%}
{%- liquid
  assign reviews = section.blocks | where: 'type', 'review'
  assign rating = section.settings.rating | strip
  assign show_reviews = false
  for block in reviews
    if block.settings.text != blank
      assign show_reviews = true
      break
    endif
  endfor
  assign live = false
  if show_reviews or rating != blank
    assign live = true
  endif
-%}
{%- if live or request.design_mode -%}
<section class="love" data-love>
  <div class="love-head">
    {%- if section.settings.eyebrow != blank -%}<p class="love-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="love-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  {%- if rating != blank or request.design_mode -%}
    {%- liquid
      assign stars = rating | times: 1.0
      if stars > 5
        assign stars = 5
      endif
      assign fill = stars | divided_by: 5.0 | times: 100 | round
    -%}
    <div class="love-google">
      <span class="love-g" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="30" height="30"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
      </span>
      <div>
        <p class="love-score">{{ rating | default: '4.8' }}{% if rating == blank %} <small>(enter your rating in Customize)</small>{% endif %}</p>
        <p class="love-meta">
          <span class="love-stars" style="--fill: {{ fill }}%;" aria-label="{{ rating }} out of 5"></span>
          <span aria-hidden="true">&middot;</span>
          {%- if section.settings.google_url != blank -%}
            <a href="{{ section.settings.google_url }}" target="_blank" rel="noopener">{{ section.settings.google_label | default: 'Google Reviews' }}</a>
          {%- else -%}
            {{ section.settings.google_label | default: 'Google Reviews' }}
          {%- endif -%}
        </p>
      </div>
    </div>
  {%- endif -%}

  {%- if show_reviews or request.design_mode -%}
    <div class="love-wrap">
    <div class="love-reviews" data-love-row>
      {%- if show_reviews -%}
        {%- for block in reviews -%}
          {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
          {%- assign who = block.settings.name | default: 'Customer' -%}
          <article class="love-review" {{ block.shopify_attributes }}>
            <header>
              <span class="love-avatar" aria-hidden="true">{{ who | slice: 0 | upcase }}</span>
              <div>
                <h3>{{ who }}</h3>
                <span class="love-stars small" style="--fill: {{ block.settings.stars | times: 20 }}%;" aria-label="{{ block.settings.stars }} out of 5"></span>
              </div>
            </header>
            <p class="love-text" id="Review-{{ block.id }}" data-love-text>{{ block.settings.text | newline_to_br }}</p>
            <button type="button" class="love-more" data-love-more aria-expanded="false" aria-controls="Review-{{ block.id }}" hidden>Read more</button>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="love-review love-empty"><p>Add a real review<br><small>Customize → Happy customers → Add review</small></p></article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <button type="button" class="love-arrow prev" data-love-prev aria-label="Previous reviews" hidden>{% render 'icon', name: 'back', size: 18 %}</button>
    <button type="button" class="love-arrow next" data-love-next aria-label="More reviews" hidden>{% render 'icon', name: 'forward', size: 18 %}</button>
    </div>
    <div class="love-dots" data-love-dots aria-hidden="true"></div>
  {%- endif -%}
</section>

<script>
  (function () {
    document.querySelectorAll('[data-love]:not([data-wired])').forEach(function (host) {
      host.setAttribute('data-wired', '');
      var texts = [].slice.call(host.querySelectorAll('[data-love-text]'));

      /* Read more only where the text really is cut off */
      function measure() {
        texts.forEach(function (p) {
          var more = p.parentNode.querySelector('[data-love-more]');
          if (!more || p.classList.contains('open')) return;
          more.hidden = p.scrollHeight <= p.clientHeight + 2;
        });
      }
      host.addEventListener('click', function (event) {
        var more = event.target.closest('[data-love-more]');
        if (!more) return;
        var p = document.getElementById(more.getAttribute('aria-controls'));
        var open = !p.classList.contains('open');
        p.classList.toggle('open', open);
        more.setAttribute('aria-expanded', open ? 'true' : 'false');
        more.textContent = open ? 'Show less' : 'Read more';
      });
      window.addEventListener('resize', measure);
      measure();

      /* the carousel: arrows step one card, dots mark each stop */
      var row = host.querySelector('[data-love-row]');
      var prev = host.querySelector('[data-love-prev]');
      var next = host.querySelector('[data-love-next]');
      var dotsBox = host.querySelector('[data-love-dots]');
      if (!row || !prev || !next || !dotsBox) return;
      var cards = [].slice.call(row.children);
      var stops = [];
      function build() {
        var max = row.scrollWidth - row.clientWidth;
        stops = [];
        cards.forEach(function (card) {
          var at = Math.min(card.offsetLeft - cards[0].offsetLeft, max);
          if (!stops.length || at - stops[stops.length - 1] > 4) stops.push(at);
        });
        dotsBox.innerHTML = '';
        if (stops.length < 2) return;
        stops.forEach(function (at) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.tabIndex = -1;
          dot.className = 'love-dot';
          dot.addEventListener('click', function () { row.scrollTo({ left: at, behavior: 'smooth' }); });
          dotsBox.appendChild(dot);
        });
      }
      function update() {
        var max = row.scrollWidth - row.clientWidth;
        prev.hidden = row.scrollLeft <= 2;
        next.hidden = row.scrollLeft >= max - 2;
        var nearest = 0, best = Infinity;
        stops.forEach(function (at, i) { var d = Math.abs(at - row.scrollLeft); if (d < best) { best = d; nearest = i; } });
        [].forEach.call(dotsBox.children, function (dot, i) { dot.classList.toggle('on', i === nearest); });
      }
      function step(dir) {
        var w = cards[0] ? cards[0].getBoundingClientRect().width + parseFloat(getComputedStyle(row).columnGap || 0) : row.clientWidth * 0.8;
        row.scrollBy({ left: dir * w, behavior: 'smooth' });
      }
      prev.addEventListener('click', function () { step(-1); });
      next.addEventListener('click', function () { step(1); });
      row.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', function () { build(); update(); });
      build();
      update();
    });
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .love { padding: var(--sec-y) 0; }
  .love-head { padding: 0 24px; margin-bottom: 22px; text-align: center; }
  .love-eyebrow { margin: 0 0 10px; font-size: var(--eyebrow-size); font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--brass, #96702e); }
  .love-head h2 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: var(--h-sec); line-height: 1.1; color: var(--ink); }
  .love-sub { margin: 10px 0 0; font-size: var(--sub-size); color: var(--ink-70); }

  .love-google { display: flex; align-items: center; justify-content: center; gap: 16px; padding: 0 24px var(--h-sec-gap); }
  .love-g { width: 58px; height: 58px; border-radius: 50%; background: #fff; display: grid; place-items: center; box-shadow: 0 2px 10px rgba(20, 17, 15, 0.1); }
  .love-score { margin: 0; font-family: var(--serif); font-size: 34px; font-weight: 500; line-height: 1; color: var(--ink); }
  .love-score small { font-size: 12px; font-weight: 400; color: var(--ink-70); }
  .love-meta { margin: 4px 0 0; display: flex; align-items: center; gap: 6px; font-size: 15px; color: var(--ink-70); }
  .love-meta a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

  /* five stars, filled to --fill: one row of pale brass, one of brass clipped over it */
  .love-stars { position: relative; display: inline-block; font-size: 20px; line-height: 1; letter-spacing: 3px; color: rgba(150, 112, 46, 0.25); }
  .love-stars::before { content: '★★★★★'; }
  .love-stars::after { content: '★★★★★'; position: absolute; left: 0; top: 0; width: var(--fill, 100%); overflow: hidden; color: var(--brass, #96702e); white-space: nowrap; }
  .love-stars.small { font-size: 17px; letter-spacing: 2px; }

  .love-wrap { position: relative; }
  /* the reviews scroll as a row at every size; the snap padding matches the
     side padding, or the row snaps in on load */
  .love-reviews {
    --rpad: 24px; --rgap: 22px;
    display: flex; align-items: flex-start; gap: var(--rgap);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--rpad);
    padding: 4px var(--rpad) 16px; scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .love-reviews::-webkit-scrollbar { display: none; }
  .love-review:first-child { margin-left: auto; }
  .love-review:last-child { margin-right: auto; }
  .love-review {
    flex: 0 0 calc((100vw - 2 * var(--rpad) - 4 * var(--rgap)) / 4.4); scroll-snap-align: start;
    background: #fff; border: 1px solid var(--line-card); border-radius: var(--r-card); padding: 24px 26px 24px;
    box-shadow: var(--shadow-card);
  }
  .love-review header { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .love-avatar {
    flex: 0 0 auto; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center;
    background: var(--tint); color: var(--brass, #96702e); font-size: 18px; font-weight: 600;
  }
  .love-review h3 { margin: 0 0 4px; font: var(--card-title); color: var(--ink); }
  /* the first four lines; Read more opens the rest */
  .love-text {
    margin: 0; font-size: 16px; line-height: 1.6; color: var(--ink-70);
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }
  .love-text.open { display: block; -webkit-line-clamp: unset; overflow: visible; }
  .love-more {
    margin-top: 10px; padding: 0; font-size: 14px; font-weight: 600; color: var(--brass, #96702e);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .love-more[hidden] { display: none; }
  .love-empty {
    display: grid; place-items: center; text-align: center; min-height: 170px;
    border: 1.5px dashed rgba(150, 112, 46, 0.45); background: rgba(239, 232, 220, 0.5); box-shadow: none;
    color: var(--ink-70); font-size: 15px; line-height: 1.5;
  }
  .love-empty small { font-size: 12px; color: var(--ink-45, rgba(20,17,15,.45)); }

  .love-arrow {
    position: absolute; top: 50%; transform: translateY(-60%); z-index: 2;
    width: var(--arrow-size); height: var(--arrow-size); border-radius: 50%; display: grid; place-items: center;
    background: #fff; color: var(--ink); box-shadow: var(--arrow-shadow);
  }
  .love-arrow[hidden] { display: none; }
  .love-arrow.prev { left: 34px; }
  .love-arrow.next { right: 34px; }
  .love-dots { display: flex; justify-content: center; gap: 8px; margin-top: 6px; min-height: 8px; }
  .love-dot { width: 8px; height: 8px; padding: 0; border-radius: 999px; background: rgba(20, 17, 15, 0.2); transition: width 0.2s, background 0.2s; }
  .love-dot.on { width: 26px; background: var(--brass, #96702e); }

  @media (max-width: 1280px) {
    .love-review { flex-basis: calc((100vw - 2 * var(--rpad) - 2 * var(--rgap)) / 3.3); }
  }
  @media (max-width: 1100px) {
    .love-review { flex-basis: calc((100vw - 2 * var(--rpad) - var(--rgap)) / 2.2); }
  }
  @media (max-width: 700px) {
    .love { padding: var(--sec-y) 0; }
    .love-head { padding: 0 16px; margin-bottom: 20px; }
    .love-sub { font-size: 15px; }
    .love-google { padding: 0 16px 20px; }
    .love-reviews { --rpad: 16px; --rgap: 14px; }
    .love-review { flex-basis: 84vw; padding: 20px; }
    .love-arrow { display: none; }
    .love-text { font-size: 15px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Happy customers",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line on top", "default": "Happy customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by customers across India" },
    { "type": "text", "id": "subheading", "label": "Line under the heading", "default": "Real outfits, made from fabric off our shelves." },
    { "type": "header", "content": "Google rating" },
    { "type": "paragraph", "content": "Copy these from your Google Business profile. The rating is hidden until you enter one." },
    { "type": "text", "id": "rating", "label": "Your Google rating", "info": "e.g. 4.8" },
    { "type": "text", "id": "google_label", "label": "Label", "default": "Google Reviews", "info": "e.g. 312 Google Reviews" },
    { "type": "url", "id": "google_url", "label": "Link to your Google reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "info": "As it appears on Google, e.g. Ananya S." },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review", "info": "Copy a real review word for word. Long ones show four lines with Read more." }
      ]
    }
  ],
  "presets": [{ "name": "Happy customers" }]
}
{% endschema %}
