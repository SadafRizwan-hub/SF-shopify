<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.col_paper }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.headless_canonical and settings.headless_origin != blank -%}
      {%- comment -%}
        The headless storefront is the public face; this Liquid theme still
        serves checkout and the admin preview. Pointing canonical at the
        headless origin keeps one page in the index rather than two.
      {%- endcomment -%}
      {%- assign headless_path = request.path -%}
      <link rel="alternate" href="{{ settings.headless_origin | append: headless_path }}">
    {%- endif -%}

    {%- if settings.load_google_fonts -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@400;500&display=swap">
    {%- endif -%}

    {%- if settings.share_image -%}
      <meta property="og:image" content="{{ settings.share_image | image_url: width: 1200 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &middot; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &middot; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- style -%}
      :root {
        --ivory: {{ settings.col_ivory }};
        --paper: {{ settings.col_paper }};
        --sand: {{ settings.col_sand }};
        --ink: {{ settings.col_ink }};
        --ink-70: {{ settings.col_ink | color_modify: 'alpha', 0.70 }};
        --ink-45: {{ settings.col_ink | color_modify: 'alpha', 0.45 }};
        --terracotta: {{ settings.col_terracotta }};
        --brass: {{ settings.col_brass }};

        --line-soft: {{ settings.col_ink | color_modify: 'alpha', 0.09 }};
        --line: {{ settings.col_ink | color_modify: 'alpha', 0.16 }};
        --line-strong: {{ settings.col_ink | color_modify: 'alpha', 0.34 }};

        --r-sm: 4px;
        --r-md: 8px;
        --r-lg: 14px;
        --r-pill: 999px;

        --shadow-card: 0 6px 22px {{ settings.col_ink | color_modify: 'alpha', 0.09 }};
        --shadow-sheet: 0 -10px 40px {{ settings.col_ink | color_modify: 'alpha', 0.22 }};

        --serif: {{ settings.serif_stack }};
        --sans: {{ settings.sans_stack }};

        --shell: 1240px;
      }
    {%- endstyle -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      /* Every metre shown anywhere is quantity * CUT_UNIT_METRES, and every
         rate is variant price / CUT_UNIT_METRES. One constant, read by the
         Liquid above and by theme.js below, exactly as the headless
         storefront reads UNIT_METRES. */
      window.SF = {
        cutUnitMetres: {{ settings.cut_unit_metres | times: 1.0 }},
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }},
          root: {{ routes.root_url | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="layout template-{{ request.page_type | handle }}">
    <a class="visually-hidden" href="#main">Skip to content</a>

    {% sections 'header-group' %}

    <main id="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <p class="toast" role="status" data-toast></p>
  </body>
</html>
