{%- comment -%}
  View & Shop: the shop's reels as a scrolling row, each one shoppable.

  Each card is a block (Customize → View & Shop → Add reel): the video,
  uploaded to Shopify (Shopify cannot pull reels from Instagram without an app
  or the Instagram API), and the fabric worn in it. The fabric's photo, name
  and rate per metre sit on a bar across the foot of the video, and the card
  opens that fabric's page to buy. A reel can point at any page instead (a
  collection, say) with its own button text. An Instagram link adds a badge
  in the corner that opens the original reel.

  Videos are muted, loop, load nothing until they are needed and play only
  while on screen, pausing when scrolled away; never under reduced motion. A
  card can be a photo instead of a video.

  With no reels the section is off the live site; in the theme editor it shows
  outlined placeholders. Styles and script live in this file.
{%- endcomment -%}
{%- liquid
  assign unit = settings.cut_unit_metres | times: 1.0
  assign factor = 1 | divided_by: unit
  assign reels = section.blocks | where: 'type', 'reel'
  assign shown = 0
  for block in reels
    if block.settings.video != blank or block.settings.image != blank
      assign shown = shown | plus: 1
    endif
  endfor
-%}
{%- if shown > 0 or request.design_mode -%}
<section class="vshop" data-vshop>
  <div class="vshop-head">
    {%- if section.settings.eyebrow != blank -%}<p class="vshop-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="vshop-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  <div class="vshop-wrap">
    <div class="vshop-row" data-vshop-row>
      {%- if shown > 0 -%}
        {%- for block in reels -%}
          {%- if block.settings.video == blank and block.settings.image == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign fabric = block.settings.product
            assign href = block.settings.link | default: fabric.url
            assign rate = fabric.price | times: factor | round
          -%}
          <article class="reel" {{ block.shopify_attributes }}>
            {%- if href != blank -%}<a class="reel-link" href="{{ href }}" aria-label="Shop {{ fabric.title | default: block.settings.button_label | escape }}"></a>{%- endif -%}
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', image_size: '720x' }}
            {%- else -%}
              {% render 'responsive-img', image: block.settings.image, alt: fabric.title, sizes: '(max-width: 700px) 62vw, 20vw' %}
            {%- endif -%}

            {%- if block.settings.instagram != blank -%}
              <a class="reel-ig" href="{{ block.settings.instagram }}" target="_blank" rel="noopener" aria-label="Watch on Instagram">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
              </a>
            {%- endif -%}

            {%- if fabric != blank -%}
              <div class="reel-shop">
                <span class="reel-thumb">
                  {%- if fabric.featured_image -%}
                    {% render 'responsive-img', image: fabric.featured_image, alt: '', sizes: '56px' %}
                  {%- endif -%}
                </span>
                <span class="reel-info">
                  <span class="reel-title">{{ fabric.title }}</span>
                  <span class="reel-price">
                    {%- if fabric.compare_at_price > fabric.price -%}<s>{{ fabric.compare_at_price | times: factor | round | money_without_trailing_zeros }}</s> {% endif -%}
                    {{ rate | money_without_trailing_zeros }}<i>/meter</i>
                  </span>
                </span>
                <span class="reel-go" aria-hidden="true">{% render 'icon', name: 'forward', size: 14 %}</span>
              </div>
            {%- elsif href != blank -%}
              <div class="reel-shop reel-shop--plain">
                <span class="reel-info"><span class="reel-title">{{ block.settings.button_label | default: 'Shop now' }}</span></span>
                <span class="reel-go" aria-hidden="true">{% render 'icon', name: 'forward', size: 14 %}</span>
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}
          <div class="reel reel-empty"><span>Add a reel<br><small>Customize → View &amp; Shop → Add reel</small></span></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <button type="button" class="vshop-arrow prev" data-vshop-prev aria-label="Scroll back" hidden>{% render 'icon', name: 'back', size: 18 %}</button>
    <button type="button" class="vshop-arrow next" data-vshop-next aria-label="Scroll on" hidden>{% render 'icon', name: 'forward', size: 18 %}</button>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-vshop]:not([data-wired])').forEach(function (host) {
      host.setAttribute('data-wired', '');
      var row = host.querySelector('[data-vshop-row]');
      var prev = host.querySelector('[data-vshop-prev]');
      var next = host.querySelector('[data-vshop-next]');
      if (row && prev && next) {
        var step = function () { return Math.max(row.clientWidth * 0.8, 240); };
        var update = function () {
          prev.hidden = row.scrollLeft <= 2;
          next.hidden = row.scrollLeft >= row.scrollWidth - row.clientWidth - 2;
        };
        prev.addEventListener('click', function () { row.scrollBy({ left: -step(), behavior: 'smooth' }); });
        next.addEventListener('click', function () { row.scrollBy({ left: step(), behavior: 'smooth' }); });
        row.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      }

      /* play a reel only while it is on screen; never for reduced motion */
      var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var clips = host.querySelectorAll('video');
      clips.forEach(function (v) { v.muted = true; v.setAttribute('muted', ''); v.removeAttribute('controls'); });
      if (calm || !('IntersectionObserver' in window)) return;
      var seen = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var v = entry.target;
          if (entry.isIntersecting) {
            if (v.preload === 'none') v.preload = 'metadata';
            var p = v.play();
            if (p && p.catch) p.catch(function () {});
          } else {
            v.pause();
          }
        });
      }, { threshold: 0.4 });
      clips.forEach(function (v) { seen.observe(v); });
    });
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .vshop { padding: 70px 0 30px; }
  .vshop-head { padding: 0 24px; margin-bottom: 28px; text-align: center; }
  .vshop-eyebrow { margin: 0 0 10px; font-size: 12px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--brass, #96702e); }
  .vshop-head h2 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(32px, 4vw, 54px); line-height: 1.1; color: var(--ink); }
  .vshop-sub { margin: 12px 0 0; font-size: 17px; color: var(--ink-70); }

  .vshop-wrap { position: relative; }
  .vshop-row {
    --vpad: 24px; --vgap: 20px;
    display: flex; gap: var(--vgap);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--vpad);
    padding: 4px var(--vpad) 18px;
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .vshop-row::-webkit-scrollbar { display: none; }
  /* a short row sits in the middle */
  .reel:first-child { margin-left: auto; }
  .reel:last-child { margin-right: auto; }

  .reel {
    position: relative; flex: 0 0 calc((100vw - 2 * var(--vpad) - 5 * var(--vgap)) / 6);
    aspect-ratio: 9 / 16; border-radius: 16px; overflow: hidden; scroll-snap-align: start;
    background: #1d1a17; box-shadow: 0 14px 28px -18px rgba(20, 17, 15, 0.4);
  }
  .reel video, .reel > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .reel::after { content: ''; position: absolute; inset: auto 0 0; height: 40%; background: linear-gradient(transparent, rgba(20, 17, 15, 0.55)); pointer-events: none; }
  /* the whole card opens the fabric; the Instagram badge sits above it */
  .reel-link { position: absolute; inset: 0; z-index: 2; }
  .reel-ig {
    position: absolute; right: 12px; top: 12px; z-index: 3; width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(255, 253, 248, 0.9); color: var(--ink);
  }
  .reel-shop {
    position: absolute; left: 10px; right: 10px; bottom: 10px; z-index: 1;
    display: flex; align-items: center; gap: 10px; padding: 8px 10px 8px 8px;
    background: rgba(255, 253, 248, 0.95); border-radius: 12px;
    box-shadow: 0 6px 18px -8px rgba(20, 17, 15, 0.45);
    transition: transform 0.2s;
  }
  .reel:hover .reel-shop { transform: translateY(-3px); }
  .reel-shop--plain { padding-left: 16px; }
  .reel-thumb { position: relative; flex: 0 0 auto; width: 46px; height: 46px; border-radius: 8px; overflow: hidden; background: var(--sand, #efe8dc); }
  .reel-thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .reel-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .reel-title { font-size: 13.5px; font-weight: 500; line-height: 1.3; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .reel-price { font-size: 13.5px; font-weight: 700; color: var(--ink); }
  .reel-price s { font-weight: 400; color: var(--ink-70); margin-right: 2px; }
  .reel-price i { font-style: normal; font-weight: 400; font-size: 12px; color: var(--ink-70); }
  .reel-go { flex: 0 0 auto; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: #14110f; color: #e8c98a; }

  .reel-empty {
    display: grid; place-items: center; text-align: center; padding: 18px;
    border: 1.5px dashed rgba(150, 112, 46, 0.45); background: rgba(239, 232, 220, 0.5); box-shadow: none;
    color: var(--ink-70); font-size: 15px; line-height: 1.5;
  }
  .reel-empty small { font-size: 12px; color: var(--ink-45, rgba(20,17,15,.45)); }
  .reel-empty::after { display: none; }

  .vshop-arrow {
    position: absolute; top: 45%; transform: translateY(-50%); z-index: 4;
    width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center;
    background: #14110f; color: #e8c98a; box-shadow: 0 4px 16px rgba(20, 17, 15, 0.25);
  }
  .vshop-arrow[hidden] { display: none; }
  .vshop-arrow.prev { left: 36px; }
  .vshop-arrow.next { right: 36px; }

  @media (max-width: 1280px) {
    .reel { flex-basis: calc((100vw - 2 * var(--vpad) - 4 * var(--vgap)) / 4.6); }
  }
  @media (max-width: 1050px) {
    .reel { flex-basis: calc((100vw - 2 * var(--vpad) - 2 * var(--vgap)) / 2.8); }
  }
  @media (max-width: 700px) {
    .vshop { padding: 50px 0 24px; }
    .vshop-head { padding: 0 16px; margin-bottom: 20px; }
    .vshop-sub { font-size: 15px; }
    .vshop-row { --vpad: 16px; --vgap: 12px; }
    .reel { flex-basis: 58vw; }
    .vshop-arrow { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "View & Shop",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line on top", "default": "As seen on Instagram" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "View & Shop" },
    { "type": "text", "id": "subheading", "label": "Line under the heading", "default": "Watch the fabric move, then take it home." }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Upload the reel (download it from Instagram first). Portrait 9:16, MP4, under a minute." },
        { "type": "image_picker", "id": "image", "label": "Photo (instead of a video)" },
        { "type": "product", "id": "product", "label": "Fabric in this reel", "info": "Shows its photo, name and rate on the reel, and the reel opens it." },
        { "type": "url", "id": "link", "label": "Or open this page instead", "info": "e.g. a collection. Leave empty to open the fabric above." },
        { "type": "text", "id": "button_label", "label": "Bar text when no fabric is picked", "default": "Shop now" },
        { "type": "url", "id": "instagram", "label": "Instagram reel (optional)", "info": "Adds a badge in the corner that opens the original reel." }
      ]
    }
  ],
  "presets": [{ "name": "View & Shop" }]
}
{% endschema %}
