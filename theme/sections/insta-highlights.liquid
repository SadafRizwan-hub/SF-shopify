{%- comment -%}
  Instagram highlights: a row of round story buttons — Bestsellers, Reviews,
  WA, FAQs — each opening the matching highlight on the shop's Instagram.

  Each circle is a block (Customize → Highlights → Add highlight): a drawn
  icon or an uploaded image, the label under it, and the highlight's link
  (open the highlight on Instagram, Share → Copy link). A circle with no link
  still shows but is not clickable, so the row can be laid out first.

  The look follows the shop's reference: an Instagram-gradient ring, a
  parchment disc with a dashed stitch ring and a stitch dot, the drawing in
  maroon. Centred on a wide screen; a swipe row on a phone if they do not fit.
  Styles live in this file, so it is one file to copy into a theme.
{%- endcomment -%}
{%- assign items = section.blocks | where: 'type', 'highlight' -%}
{%- if items.size > 0 -%}
<section class="hilite">
  {%- if section.settings.heading != blank -%}<h2 class="hilite-heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="hilite-row">
    {%- for block in items -%}
      {%- assign label = block.settings.label | default: 'Highlight' -%}
      {%- if block.settings.link != blank -%}
        <a class="hilite-item" href="{{ block.settings.link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
      {%- else -%}
        <div class="hilite-item" {{ block.shopify_attributes }}>
      {%- endif -%}
        <span class="hilite-ring">
          <span class="hilite-disc">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', class: 'hilite-img' }}
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'bestseller' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true"><g transform="rotate(-14 32 32)"><circle cx="32" cy="32" r="21" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="32" cy="32" r="17.5" fill="none" stroke="currentColor" stroke-width=".9" stroke-dasharray="1.6 1.4"/><rect x="4" y="25.5" width="56" height="13" rx="2.5" fill="currentColor"/><text x="32" y="34.6" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="7.2" font-weight="700" fill="#f6ead2" letter-spacing=".2">BESTSELLER</text><text x="32" y="20.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="3.2" font-weight="700" fill="currentColor" letter-spacing=".5">BESTSELLER</text><text x="32" y="46" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="3.2" font-weight="700" fill="currentColor" letter-spacing=".5">BESTSELLER</text></g></svg>
                {%- when 'reviews' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M14 9h36a4 4 0 0 1 4 4v9a4 4 0 0 1-4 4H30l-6 5v-5H14a4 4 0 0 1-4-4v-9a4 4 0 0 1 4-4z"/><path d="m21 13.6 1.2 2.4 2.7.4-2 1.9.5 2.6-2.4-1.2-2.4 1.2.5-2.6-2-1.9 2.7-.4zM32 11.6l1.2 2.4 2.7.4-2 1.9.5 2.6-2.4-1.2-2.4 1.2.5-2.6-2-1.9 2.7-.4zM43 13.6l1.2 2.4 2.7.4-2 1.9.5 2.6-2.4-1.2-2.4 1.2.5-2.6-2-1.9 2.7-.4z"/><path d="M20 39h6v18h-6z"/><path d="M26 41.5c3-1.5 5.5-5 6.5-9 .5-2 3.5-2 4 .5.5 2.2-.4 5-1.5 7H45a3.2 3.2 0 0 1 .5 6.3 3.2 3.2 0 0 1-.8 6 3 3 0 0 1-1.5 5.2H31c-2 0-3.5-.5-5-1.5"/></svg>
                {%- when 'whatsapp' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"><path d="M13.5 52l3.4-10.3A19.5 19.5 0 1 1 24 49.2z"/><path stroke-width="2.4" d="M24.6 22.6c-1.4 1.4-1.7 3.8 0 7 1.9 3.4 5.3 6.6 8.5 8.1 2.8 1.3 4.9.8 6.2-.7l-.4-2.5-4.2-1.9-2 1.9c-2.6-1.1-4.9-3.4-6-6l1.9-2-1.9-4.2z"/></svg>
                {%- when 'faq' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M22 23V17a4 4 0 0 1 4-4h26a4 4 0 0 1 4 4v14a4 4 0 0 1-4 4h-3v6l-7-6h-4"/><path d="M8 27a4 4 0 0 1 4-4h24a4 4 0 0 1 4 4v14a4 4 0 0 1-4 4H22l-8 7v-7h-2a4 4 0 0 1-4-4z"/><text x="24" y="38.2" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="700" fill="currentColor" stroke="none" letter-spacing=".4">FAQ</text></svg>
                {%- when 'new' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="m32 7 5 6.4 7.8-2.3.6 8.1 7.6 3-4 7 4 7-7.6 3-.6 8.1-7.8-2.3L32 57l-5-6.4-7.8 2.3-.6-8.1-7.6-3 4-7-4-7 7.6-3 .6-8.1 7.8 2.3z"/><text x="32" y="36" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="10" font-weight="700" fill="currentColor" stroke="none">NEW</text></svg>
                {%- when 'fabric' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M10 20c7-5 14-5 21 0s14 5 21 0v26c-7 5-14 5-21 0s-14-5-21 0z"/><path d="M18 27c4 2 8 2 12 0M32 33c4 2 8 2 12 0M18 39c4 2 8 2 12 0"/></svg>
                {%- when 'delivery' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M8 18h28v24H8zM36 26h10l8 9v7H36"/><circle cx="17" cy="45" r="4.5"/><circle cx="46" cy="45" r="4.5"/></svg>
                {%- when 'offer' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M34 8h18a4 4 0 0 1 4 4v18L30 56 8 34z"/><circle cx="45" cy="19" r="3.4"/><path d="m24 40 12-12M25 30.5h.1M35 39.5h.1" stroke-width="3"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </span>
        </span>
        <span class="hilite-label">{{ label }}</span>
      {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .hilite { padding: 56px 16px 10px; text-align: center; }
  .hilite-heading { margin: 0 0 26px; font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 3.2vw, 44px); color: var(--ink); }
  .hilite-row {
    display: flex; justify-content: center; gap: clamp(22px, 4vw, 64px);
    overflow-x: auto; scrollbar-width: none; padding: 4px 8px 8px;
  }
  .hilite-row::-webkit-scrollbar { display: none; }
  .hilite-item { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; gap: 12px; color: var(--ink); }
  /* Instagram's ring, a white gap, then the parchment disc */
  .hilite-ring {
    width: 158px; height: 158px; border-radius: 50%; padding: 5px;
    background: linear-gradient(45deg, #f9a03f 0%, #f0574a 30%, #d6297a 60%, #a12bb4 100%);
    transition: transform 0.2s ease;
  }
  .hilite-item:hover .hilite-ring { transform: scale(1.04); }
  .hilite-disc {
    position: relative; display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%;
    border: 5px solid #fff; overflow: hidden; color: #8e1b1f;
    background:
      radial-gradient(circle at 30% 28%, rgba(255, 252, 240, 0.9), transparent 45%),
      radial-gradient(circle at 72% 70%, rgba(190, 150, 95, 0.28), transparent 40%),
      radial-gradient(circle at 20% 78%, rgba(180, 130, 80, 0.18), transparent 30%),
      #ead9bb;
  }
  /* the stitched ring and its dot */
  .hilite-disc::before {
    content: ''; position: absolute; inset: 9px; border-radius: 50%;
    border: 1.6px dashed rgba(142, 27, 31, 0.7);
  }
  .hilite-disc::after {
    content: ''; position: absolute; left: 50%; bottom: 5px; width: 5px; height: 5px; margin-left: -2.5px;
    border-radius: 50%; background: #c08a3e;
  }
  .hilite-disc svg { position: relative; width: 62%; height: 62%; }
  .hilite-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hilite-label { font-size: 18px; letter-spacing: 0.2px; }

  @media (max-width: 700px) {
    .hilite { padding: 40px 0 6px; }
    .hilite-heading { margin-bottom: 18px; }
    .hilite-row { justify-content: flex-start; gap: 14px; padding: 4px 16px 8px; }
    /* centre the row when it fits; auto margins never clip a longer one */
    .hilite-item:first-child { margin-left: auto; }
    .hilite-item:last-child { margin-right: auto; }
    /* four across a 390px phone: 4 x 76 + 3 x 14 + 32 = 378 */
    .hilite-ring { width: 76px; height: 76px; padding: 3px; }
    .hilite-disc { border-width: 3px; }
    .hilite-disc::before { inset: 5px; border-width: 1.2px; }
    .hilite-disc::after { bottom: 3px; width: 4px; height: 4px; margin-left: -2px; }
    .hilite-label { font-size: 13.5px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Highlights",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)", "info": "Leave empty to show just the circles." }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "bestseller",
          "options": [
            { "value": "bestseller", "label": "Bestseller stamp" },
            { "value": "reviews", "label": "Reviews (thumbs up)" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "faq", "label": "FAQ" },
            { "value": "new", "label": "New" },
            { "value": "fabric", "label": "Fabric" },
            { "value": "delivery", "label": "Delivery" },
            { "value": "offer", "label": "Offer tag" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Your own picture (optional)", "info": "Replaces the drawn icon. Square." },
        { "type": "text", "id": "label", "label": "Label", "default": "Bestsellers" },
        { "type": "url", "id": "link", "label": "Instagram highlight link", "info": "On Instagram open the highlight, tap ⋯ → Copy link, paste it here." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Highlights",
      "blocks": [
        { "type": "highlight", "settings": { "icon": "bestseller", "label": "Bestsellers" } },
        { "type": "highlight", "settings": { "icon": "reviews", "label": "Reviews" } },
        { "type": "highlight", "settings": { "icon": "whatsapp", "label": "WA" } },
        { "type": "highlight", "settings": { "icon": "faq", "label": "FAQs" } }
      ]
    }
  ]
}
{% endschema %}
