{%- if settings.whatsapp_number != blank -%}
  {%- assign wa_text = settings.whatsapp_message | url_encode -%}
  <a
    class="wa"
    href="https://wa.me/{{ settings.whatsapp_number }}?text={{ wa_text }}"
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp"
  >
    {% render 'icon', name: 'whatsapp', size: 22 %}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp button",
  "settings": [
    {
      "type": "paragraph",
      "content": "The number and the prefilled message live in Theme settings - Contact, so they can be changed without touching a section."
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
