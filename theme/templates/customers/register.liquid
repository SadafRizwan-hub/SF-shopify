<div class="shell acct">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label class="field"><span>{{ 'customer.register.first_name' | t }}</span>
      <input type="text" name="customer[first_name]" autocomplete="given-name"></label>
    <label class="field"><span>{{ 'customer.register.last_name' | t }}</span>
      <input type="text" name="customer[last_name]" autocomplete="family-name"></label>
    <label class="field"><span>{{ 'customer.register.email' | t }}</span>
      <input type="email" name="customer[email]" autocomplete="email" required></label>
    <label class="field"><span>{{ 'customer.register.password' | t }}</span>
      <input type="password" name="customer[password]" autocomplete="new-password"></label>
    <button type="submit" class="btn btn-primary">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div>
