<div class="shell acct" style="max-width:860px">
  <h1>{{ 'customer.account.title' | t }}</h1>
  <p class="meta">{{ customer.email }} &middot;
    <a class="linkish" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }}</a> &middot;
    <a class="linkish" href="{{ routes.account_logout_url }}">Sign out</a>
  </p>

  <h2 style="margin-top:30px">{{ 'customer.account.orders' | t }}</h2>
  {%- if customer.orders.size > 0 -%}
    <table>
      <thead>
        <tr>
          <th>{{ 'customer.orders.order_number' | t }}</th>
          <th>{{ 'customer.orders.date' | t }}</th>
          <th>{{ 'customer.orders.payment_status' | t }}</th>
          <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
          <th>{{ 'customer.orders.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for order in customer.orders -%}
          <tr>
            <td><a class="linkish" href="{{ order.customer_url }}">{{ order.name }}</a></td>
            <td>{{ order.created_at | date: '%d %b %Y' }}</td>
            <td>{{ order.financial_status_label }}</td>
            <td>{{ order.fulfillment_status_label }}</td>
            <td>{{ order.total_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- else -%}
    <p class="meta">{{ 'customer.orders.none' | t }}</p>
  {%- endif -%}
</div>
