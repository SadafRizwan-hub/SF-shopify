<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {%- style -%}
      :root {
        --ivory: {{ settings.col_ivory }};
        --paper: {{ settings.col_paper }};
        --sand: {{ settings.col_sand }};
        --ink: {{ settings.col_ink }};
        --ink-70: {{ settings.col_ink | color_modify: 'alpha', 0.70 }};
        --ink-45: {{ settings.col_ink | color_modify: 'alpha', 0.45 }};

        /* Translucent surfaces. Generated here rather than with CSS
           color-mix(): an unsupported color-mix() makes the whole background
           declaration invalid, which leaves the sticky header transparent and
           its links sitting unreadably on top of the page. */
        --paper-90: {{ settings.col_paper | color_modify: 'alpha', 0.90 }};
        --paper-94: {{ settings.col_paper | color_modify: 'alpha', 0.94 }};
        --paper-95: {{ settings.col_paper | color_modify: 'alpha', 0.95 }};
        --ivory-90: {{ settings.col_ivory | color_modify: 'alpha', 0.90 }};
        --ivory-92: {{ settings.col_ivory | color_modify: 'alpha', 0.92 }};
        --terracotta: {{ settings.col_terracotta }};
        --brass: {{ settings.col_brass }};
        --line-soft: {{ settings.col_ink | color_modify: 'alpha', 0.09 }};
        --line: {{ settings.col_ink | color_modify: 'alpha', 0.16 }};
        --line-strong: {{ settings.col_ink | color_modify: 'alpha', 0.34 }};
        --r-sm: 4px; --r-md: 8px; --r-lg: 14px; --r-pill: 999px;
        --serif: {{ settings.serif_stack }};
        --sans: {{ settings.sans_stack }};
        --shell: 1240px;
      }
    {%- endstyle -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="layout">
    <main id="main" class="shell acct" style="padding-top:80px">
      <span class="mark" style="font-family:var(--serif);font-size:30px">SF</span>
      <h1 style="margin-top:12px">{{ shop.name }}</h1>
      {{ content_for_layout }}
    </main>
  </body>
</html>
