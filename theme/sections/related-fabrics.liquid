{%- comment -%}
  Shopify's own recommendations, so "goes with this" is the store's data and
  not a guess made in Liquid. Renders nothing when there is nothing to show.
{%- endcomment -%}
<div
  class="shell related"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <h2>{{ section.settings.heading }}</h2>
    <div class="grid" style="--cols: {{ section.settings.columns }};">
      {%- for product in recommendations.products -%}
        {% render 'fabric-card', product: product %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var host = document.querySelector('[data-recommendations]');
    if (!host || host.querySelector('.grid')) return;
    fetch(host.dataset.url)
      .then(function (response) { return response.text(); })
      .then(function (html) {
        var fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-recommendations]');
        if (fresh) host.innerHTML = fresh.innerHTML;
      })
      .catch(function () {
        /* recommendations are a nicety — a failed fetch leaves the page whole */
      });
  })();
</script>

{% schema %}
{
  "name": "Goes with this",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Goes with this" },
    { "type": "range", "id": "count", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
