{%- liquid
  assign source = collections[section.settings.collection]
  unless source.products.size > 0
    assign source = collections.all
  endunless
  assign count = section.settings.count | default: 8

  # The shelf reads newest-first by default: a quality entered at the counter
  # today is the one worth showing, and the admin should not have to rebuild a
  # collection to say so. Liquid hands over at most 50 products outside a
  # paginate, so past that size point this at a collection Shopify itself
  # sorts newest-first.
  assign items = source.products
  if section.settings.order != 'collection'
    assign items = items | sort: 'created_at' | reverse
  endif
  # never let the re-sort be the reason a shelf looks empty
  if items.size == 0
    assign items = source.products
  endif
-%}
{%- if source.products.size > 0 -%}
  <section class="shell homeband">
    <div class="head">
      {%- if section.settings.eyebrow != blank -%}<p class="sec-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link_url != blank -%}
        <a class="linkish" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    {%- comment -%}
      Two rows first, then View more opens two more at a time. The rows are
      counted by the script from however many columns the screen shows, so
      it is two rows on a monitor and on a phone alike. Once every fabric
      here is showing, the button becomes a link to the full catalog. Without
      the script every fabric shows and there is no button.
    {%- endcomment -%}
    <div class="grid" style="--cols: {{ section.settings.columns }};" data-more-grid data-rows="{{ section.settings.rows | default: 2 }}">
      {%- for product in items limit: count -%}
        {% render 'fabric-card', product: product %}
      {%- endfor -%}
    </div>
    <div class="moreband">
      <button type="button" class="btn btn-ghost morebtn" data-more hidden>{{ section.settings.more_label | default: 'View more' }}</button>
      <a class="btn btn-ghost morebtn" data-more-all href="{{ section.settings.link_url | default: routes.all_products_collection_url }}" hidden>{{ section.settings.all_label | default: 'See the full catalog' }}</a>
    </div>
  </section>

  <script>
    (function () {
      document.querySelectorAll('[data-more-grid]:not([data-wired])').forEach(function (grid) {
        grid.setAttribute('data-wired', '');
        var band = grid.nextElementSibling;
        var more = band && band.querySelector('[data-more]');
        var all = band && band.querySelector('[data-more-all]');
        if (!more || !all) return;
        var rows = parseInt(grid.getAttribute('data-rows'), 10) || 2;
        var items = [].slice.call(grid.children);
        var open = rows;

        function cols() { return getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length || 1; }
        function show() {
          var limit = open * cols();
          items.forEach(function (el, i) { el.hidden = i >= limit; });
          var rest = items.length > limit;
          more.hidden = !rest;
          all.hidden = rest;
        }
        more.addEventListener('click', function () {
          var first = open * cols();
          open += rows;
          show();
          /* keep the shopper where they were: focus the first new fabric */
          var link = items[first] && items[first].querySelector('a');
          if (link) link.focus({ preventScroll: true });
        });
        window.addEventListener('resize', show);
        show();
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "By the metre",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line on top", "default": "Cut to your length" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "By the metre"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products",
      "min": 2,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "select",
      "id": "order",
      "label": "Order",
      "info": "Newest first reads the newest of the products Liquid exposes (50). Past that, point this at a collection whose own sort order is 'Newest first'.",
      "default": "newest",
      "options": [
        {
          "value": "newest",
          "label": "Newest first"
        },
        {
          "value": "collection",
          "label": "The collection's own order"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Rows shown before View more",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "View more button",
      "default": "View more"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Button once everything is shown",
      "default": "See the full catalog"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See all"
    }
  ],
  "presets": [
    {
      "name": "By the metre"
    }
  ]
}
{% endschema %}
