{%- paginate blog.articles by 12 -%}
  <div class="shell book">
    <header class="top">
      <h1>{{ blog.title }}</h1>
    </header>
    <div class="bookgrid">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          {%- if article.image -%}
            {% render 'fabric-surface', image: article.image, alt: article.title, ratio: '4 / 3', sizes: '(max-width: 700px) 50vw, 25vw' %}
          {%- endif -%}
          <h3>{{ article.title }}</h3>
          <p class="meta">{{ article.published_at | date: '%d %b %Y' }}</p>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pager">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}<span{% if part.title == paginate.current_page %} class="on"{% endif %}>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}
