{%- comment -%}
  The design book sits across qualities. A design is a collection whose handle
  starts with the design prefix; one with no cloth posted under it opens onto
  nothing, so it isn't shown.
{%- endcomment -%}
{%- liquid
  assign prefix = settings.design_collection_prefix | default: 'design-'
  assign shown = 0
  assign limit = section.settings.count | default: 6
-%}
{%- capture cards -%}
  {%- for collection in collections -%}
    {%- if shown >= limit -%}{%- break -%}{%- endif -%}
    {%- unless collection.handle contains prefix -%}{%- continue -%}{%- endunless -%}
    {%- if collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    <a class="dcard" href="{{ collection.url }}">
      {% render 'fabric-surface',
        image: collection.image | default: collection.products.first.featured_image,
        alt: collection.title,
        ratio: '4 / 3',
        sizes: '(max-width: 700px) 50vw, 33vw' %}
      <span class="dn">{{ collection.title }}</span>
      <span class="meta">{{ collection.description | strip_html | truncate: 70 }}</span>
    </a>
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  <section class="shell homeband">
    <div class="head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link_url != blank -%}
        <a class="linkish" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.body != blank -%}
      <p class="subline">{{ section.settings.body }}</p>
    {%- endif -%}
    <div class="designrow">{{ cards }}</div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Design book row",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One design, many grounds" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The design book sits across qualities — pick the drawing first, then choose which cloth it should be printed on."
    },
    { "type": "range", "id": "count", "label": "Designs", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All designs" }
  ],
  "presets": [{ "name": "Design book row" }]
}
{% endschema %}
