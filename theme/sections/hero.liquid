{%- comment -%}
  The hero sells the first product the admin has arranged in the chosen
  collection, using its own photo, name and rate. With an empty collection it
  keeps the shop photograph and drops the product line and the shop-this
  button entirely — never a call to action for stock that doesn't exist.
{%- endcomment -%}
{%- liquid
  assign unit = settings.cut_unit_metres | times: 1.0
  assign factor = 1 | divided_by: unit

  assign source = collections[section.settings.collection]
  unless source.products.size > 0
    assign source = collections.all
  endunless
  # "New this week" means the newest thing on the shelf, not whatever sorts
  # first alphabetically. Same 50-product caveat as the grid below it.
  assign items = source.products
  if section.settings.order != 'collection'
    assign items = items | sort: 'created_at' | reverse
  endif
  # never let the re-sort be the reason a shelf looks empty
  if items.size == 0
    assign items = source.products
  endif
  # Lead with the newest fabric that HAS a photograph. A product entered at the
  # counter before its photographs are uploaded is the newest thing on the shelf
  # and the worst thing to put on a banner: the picture is the banner. Only when
  # nothing on the shelf has a photo does the lead fall back to the newest.
  assign hero = items.first
  if section.settings.prefer_product_photo
    for candidate in items
      if candidate.featured_image
        assign hero = candidate
        break
      endif
    endfor
  endif
  # A quality is a product TYPE — Georgette, Chanderi, Cambric — not a product:
  # two georgettes are one quality in two cloths. This counted products, so a
  # shelf of seven fabrics in five types read "7 qualities". It counts the
  # distinct types instead, the same way the Shop-by-quality chips build their
  # list, so the lede and the chips can never disagree.
  #
  # Liquid hands over at most 50 products outside a paginate, so past that the
  # count covers the first 50. A shelf with no types typed at all falls back to
  # the product count rather than claiming "0 qualities".
  assign type_seen = ','
  assign qualities = 0
  for p in collections.all.products
    assign type_key = p.type | strip | downcase
    if type_key == blank
      continue
    endif
    assign type_probe = ',' | append: type_key | append: ','
    unless type_seen contains type_probe
      assign type_seen = type_seen | append: type_key | append: ','
      assign qualities = qualities | plus: 1
    endunless
  endfor
  if qualities == 0
    assign qualities = collections.all.products_count
  endif

  assign hero_image = section.settings.image
  if hero and hero.featured_image and section.settings.prefer_product_photo
    assign hero_image = hero.featured_image
  endif

  assign subtitle = hero.metafields.custom.subtitle.value | default: hero.description | strip_html | truncate: 90

  # "New this week" was fixed text, so it said so whether the fabric went up
  # yesterday or last year. It is now shown only while the lead product is
  # actually inside the new window, and takes itself off when that passes.
  capture hero_fresh
    render 'is-new', product: hero
  endcapture
  assign eyebrow = section.settings.eyebrow_old
  if hero_fresh == 'new'
    assign eyebrow = section.settings.eyebrow
  endif
-%}
<section class="hero{% unless hero_image %} bare{% endunless %}">
  {%- if hero_image -%}
    {% render 'responsive-img',
      image: hero_image,
      alt: shop.name,
      sizes: '100vw',
      loading: 'eager',
      fetchpriority: 'high' %}
  {%- endif -%}
  <div class="veil"></div>

  <div class="shell copy">
    {%- if hero -%}
      {%- if eyebrow != blank -%}<span class="eyebrow">{{ eyebrow }}</span>{%- endif -%}
      <h1>{{ hero.title }},<br>{{ section.settings.heading_tail | default: 'cut to your metre' }}</h1>
      <p class="lede">
        {%- if subtitle != blank %}{{ subtitle }}. {% endif -%}
        {{ qualities }} {% if qualities == 1 %}quality{% else %}qualities{% endif %} on the floor,
        dyed shades on most of them, and every rate is the wholesale rate.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="{{ hero.url }}">
          Shop {{ hero.title }} &middot; {{ hero.price | times: factor | round | money }}/m
        </a>
        {%- if section.settings.catalog_url != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.catalog_url }}">
            Browse all {{ qualities }} {% if qualities == 1 %}quality{% else %}qualities{% endif %}
          </a>
        {%- endif -%}
      </div>
    {%- else -%}
      <h1>{{ section.settings.empty_heading | default: 'Wholesale cloth,' }}<br>{{ section.settings.heading_tail | default: 'cut to your metre' }}</h1>
      <p class="lede">{{ section.settings.empty_body }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Lead from this collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback photograph"
    },
    {
      "type": "checkbox",
      "id": "prefer_product_photo",
      "label": "Use the lead product's own photo",
      "default": true
    },
    {
      "type": "select",
      "id": "order",
      "label": "Order",
      "info": "Newest first reads the newest of the products Liquid exposes (50). Past that, point this at a collection whose own sort order is 'Newest first'.",
      "default": "newest",
      "options": [
        {
          "value": "newest",
          "label": "Newest first"
        },
        {
          "value": "collection",
          "label": "The collection's own order"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow while the fabric is new",
      "info": "Shown only while the lead fabric is inside Theme settings → The counter → New for. It takes itself off after that.",
      "default": "New this week"
    },
    {
      "type": "text",
      "id": "eyebrow_old",
      "label": "Eyebrow once it is not new",
      "info": "Leave empty to show nothing above the heading."
    },
    {
      "type": "text",
      "id": "heading_tail",
      "label": "Second line",
      "default": "cut to your metre"
    },
    {
      "type": "url",
      "id": "catalog_url",
      "label": "Catalog link"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading with an empty shelf",
      "default": "Wholesale cloth,"
    },
    {
      "type": "textarea",
      "id": "empty_body",
      "label": "Body with an empty shelf",
      "default": "Cut fresh off the than at the wholesale rate, to the length you ask for. The counter is open — the catalog goes up here as stock lands."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
