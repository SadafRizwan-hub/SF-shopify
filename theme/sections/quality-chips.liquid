{%- comment -%}
  A shortcut into the catalog by product type. A type with nothing posted
  under it would open an empty grid, so it isn't offered — the chips are built
  from the types actually on the shelf, never from a fixed list that can drift.
{%- endcomment -%}
{%- liquid
  assign source = collections[section.settings.collection] | default: collections.all
  assign types = ''
  for product in source.products
    assign key = product.type | strip
    if key == blank
      continue
    endif
    assign probe = ',' | append: key | append: ','
    assign haystack = ',' | append: types | append: ','
    unless haystack contains probe
      assign types = types | append: key | append: ','
    endunless
  endfor
  assign type_list = types | split: ','
-%}
{%- if type_list.size > 0 -%}
  <section class="shell homeband">
    <div class="head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link_url != blank -%}
        <a class="linkish" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="types">
      {%- for type in type_list -%}
        {%- comment -%}
          The catalog, newest first, with this quality lifted to the top: its
          fabrics new to old, then everything else new to old. Nothing is
          filtered away — the shopper asked where to start, not what to hide.
          #first= is read by catalog-filters.js; it ignores a quality the page
          does not carry.
        {%- endcomment -%}
        <a class="chip" href="{{ source.url | default: routes.all_products_collection_url }}?sort_by=created-descending#first={{ type | handle }}">{{ type }}</a>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Shop by quality",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by quality" },
    { "type": "collection", "id": "collection", "label": "Read types from" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See the full catalog" }
  ],
  "presets": [{ "name": "Shop by quality" }]
}
{% endschema %}
