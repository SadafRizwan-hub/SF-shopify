{%- liquid
  assign source = collections[section.settings.collection]
  unless source.products.size > 0
    assign source = collections.all
  endunless
  assign count = section.settings.count | default: 8
-%}
{%- if source.products.size > 0 -%}
  <section class="shell homeband">
    <div class="head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link_url != blank -%}
        <a class="linkish" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="grid" style="--cols: {{ section.settings.columns }};">
      {%- for product in source.products limit: count -%}
        {% render 'fabric-card', product: product %}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "By the metre",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "By the metre" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See all" }
  ],
  "presets": [{ "name": "By the metre" }]
}
{% endschema %}
