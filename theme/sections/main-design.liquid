{%- comment -%}
  One design from the book: the drawing, the shades it is dyed in across every
  ground it sits on, and the grounds themselves. A design page is only a page
  if there is cloth under it.

  Applied to a collection by choosing the "design" template on that collection
  in the admin.
{%- endcomment -%}
{%- liquid
  assign unit = settings.cut_unit_metres | times: 1.0
  assign factor = 1 | divided_by: unit
  assign shade_names = 'shade,shades,colour,colours,color,colors' | split: ','
  assign prefix = settings.design_collection_prefix | default: 'design-'

  # the counter's own taxonomy: see snippets/design-families.liquid
  assign fam_raw = collection.metafields.custom.design_family.value
  assign fam_joined = fam_raw | join: ','
  assign fam_parts = fam_joined | split: ','

  assign book_url = section.settings.book_url | default: pages['design-book'].url | default: routes.collections_url

  assign shades = ''
  for product in collection.products
    for option in product.options_with_values
      assign key = option.name | strip | downcase
      unless shade_names contains key
        continue
      endunless
      for value in option.values
        assign probe = '|' | append: value | append: '|'
        assign haystack = '|' | append: shades | append: '|'
        unless haystack contains probe
          assign shades = shades | append: value | append: '|'
        endunless
      endfor
    endfor
  endfor
  assign shade_list = shades | split: '|'
-%}

<div class="shell book design">
  <a class="back" href="{{ section.settings.book_url | default: pages['design-book'].url | default: routes.collections_url }}">
    {% render 'icon', name: 'back', size: 13 %} All designs
  </a>

  {%- if collection.products_count == 0 -%}
    <div class="gone">
      <h1>{{ collection.title }}</h1>
      <p class="meta">There's no cloth listed under this design at the moment. The rest of the book is still open.</p>
      <a class="btn btn-primary" href="{{ section.settings.book_url | default: pages['design-book'].url | default: routes.collections_url }}">Back to the design book</a>
    </div>
  {%- else -%}
    <header class="head">
      <h1>{{ collection.title }}</h1>
      <p class="meta" data-design-count>
        Design &middot; available on {{ collection.products_count }}
        {% if collection.products_count == 1 %}fabric{% else %}fabrics{% endif %}
      </p>
      {%- if fam_parts.size > 0 -%}
        <nav class="families" aria-label="Design family" style="margin-top:14px;padding-bottom:0;border:0;">
          {%- for part in fam_parts -%}
            {%- assign fam_name = part | strip -%}
            {%- if fam_name == blank -%}{%- continue -%}{%- endif -%}
            {%- assign fam_slug = fam_name | handle -%}
            <a class="chip" href="{{ book_url }}?family={{ fam_slug }}">{{ fam_name }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </header>

    <div class="split">
      <div class="visual">
        {%- assign book_image = collection.image | default: collection.products.first.featured_image -%}
        {%- capture shown_badge -%}<span class="shown" data-design-shown hidden></span>{%- endcapture -%}
        <div data-design-main data-image-id="{{ book_image.id }}">
          {% render 'fabric-surface',
            image: book_image,
            alt: collection.title,
            ratio: '4 / 3',
            sizes: '(max-width: 900px) 100vw, 50vw',
            overlay: shown_badge %}
        </div>
        {%- if collection.description != blank -%}
          <div class="tagline rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>

      <div class="detail">
        {%- if shade_list.size > 0 -%}
          {%- comment -%}
            These were a legend — a row of colours with nothing behind them.
            They are the page's filter now: picking one moves the drawing to
            that colourway and narrows the grounds below to the ones that
            actually come in it. Buttons, not spans, so the keyboard and a
            screen reader get the same page the mouse does.
          {%- endcomment -%}
          <section class="block">
            <header>
              <span class="label">This design comes in</span>
              <button type="button" class="chosen linkish" data-shade-reset hidden>Show every shade</button>
            </header>
            <div class="shadegrid" style="--cols: {{ section.settings.shade_columns }};" data-shade-grid>
              {%- for value in shade_list -%}
                {%- capture hex %}{% render 'shade-hex', name: value %}{% endcapture -%}
                <button type="button" class="cell" data-shade="{{ value | escape }}" aria-pressed="false">
                  <span class="swatch" style="background: {{ hex | strip }};"></span>
                  <span class="name">{{ value }}</span>
                </button>
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}

        <section class="block">
          <header><span class="label">On which fabric</span></header>
          <div class="grounds" data-grounds>
            {%- for product in collection.products -%}
              {%- liquid
                assign stock = 'in stock'
                unless product.available
                  assign stock = 'out of stock'
                endunless
                assign width = product.metafields.custom.width.value | default: '—'
              -%}
              <a class="ground" href="{{ product.url }}" data-ground="{{ product.id }}" data-url="{{ product.url }}">
                <span class="gthumb" data-ground-thumb data-image-id="{{ product.featured_image.id }}">
                  {% render 'fabric-surface', image: product.featured_image, alt: product.title, ratio: '1 / 1', sizes: '52px' %}
                </span>
                <span class="gtext">
                  <b>{{ product.title }}</b>
                  <i class="meta">{{ width }} &middot; {{ stock }}</i>
                </span>
                <span class="rate">{{ product.price | times: factor | round | money }}<span class="per">/m</span></span>
              </a>
            {%- endfor -%}
          </div>
          <p class="meta" data-grounds-empty hidden>No ground on this page is dyed in that shade.</p>
        </section>

        {%- comment -%}
          Siblings in the same family. The book's taxonomy is only worth having
          if it leads somewhere from a design, not just down from the index.
        {%- endcomment -%}
        {%- if fam_parts.size > 0 -%}
          {%- assign siblings = 0 -%}
          {%- capture sibling_cards -%}
            {%- for other in collections -%}
              {%- if siblings >= 4 -%}{%- break -%}{%- endif -%}
              {%- unless other.handle contains prefix -%}{%- continue -%}{%- endunless -%}
              {%- if other.handle == collection.handle or other.products_count == 0 -%}{%- continue -%}{%- endif -%}
              {%- capture other_families %}{% render 'design-of', collection: other %}{% endcapture -%}
              {%- assign other_families = other_families | strip -%}
              {%- if other_families == blank -%}{%- continue -%}{%- endif -%}
              {%- assign shares = false -%}
              {%- for part in fam_parts -%}
                {%- assign fam_slug = part | strip | handle -%}
                {%- if fam_slug != blank and other_families contains fam_slug -%}
                  {%- assign shares = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- unless shares -%}{%- continue -%}{%- endunless -%}
              {%- assign siblings = siblings | plus: 1 -%}
              {%- assign sib_image = other.image | default: other.products.first.featured_image -%}
              <a class="card" href="{{ other.url }}">
                {% render 'fabric-surface', image: sib_image, alt: other.title, ratio: '4 / 3', sizes: '(max-width: 700px) 50vw, 25vw' %}
                <h3>{{ other.title }}</h3>
                <p class="on">On {{ other.products_count }} {% if other.products_count == 1 %}quality{% else %}qualities{% endif %}</p>
              </a>
            {%- endfor -%}
          {%- endcapture -%}
          {%- if siblings > 0 -%}
            <section class="block">
              <header><span class="label">More in this family</span></header>
              <div class="bookgrid">{{ sibling_cards }}</div>
            </section>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.swatch_url != blank -%}
          <div class="actions" style="margin-top: 20px;">
            <a class="btn btn-ghost" href="{{ section.settings.swatch_url }}">Order a swatch card</a>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}
      What each ground is dyed in, and which photograph belongs to which
      shade of it. Emitted as a flat list per ground rather than a map keyed
      by shade, so two variants of the same colour cannot collide into
      duplicate JSON keys and take the whole payload — and with it the page —
      down. The script picks the first match.
    {%- endcomment -%}
    <script type="application/json" data-design-json>
      {
        "hero": {% if book_image %}{{ book_image | image_url: width: 1400 | json }}{% else %}null{% endif %},
        "heroId": {% if book_image %}{{ book_image.id }}{% else %}null{% endif %},
        "grounds": [
          {%- for product in collection.products -%}
            {%- liquid
              assign p_shade_i = -1
              for option in product.options_with_values
                assign key = option.name | strip | downcase
                if shade_names contains key
                  assign p_shade_i = forloop.index0
                  break
                endif
              endfor
            -%}
            {
              "id": {{ product.id }},
              "url": {{ product.url | json }},
              "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %},
              "imageId": {% if product.featured_image %}{{ product.featured_image.id }}{% else %}null{% endif %},
              "thumb": {% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %},
              "shades": [
                {%- assign first_row = true -%}
                {%- for variant in product.variants -%}
                  {%- if p_shade_i < 0 -%}{%- continue -%}{%- endif -%}
                  {%- assign shade_value = variant.options[p_shade_i] -%}
                  {%- if shade_value == blank -%}{%- continue -%}{%- endif -%}
                  {%- unless first_row %},{% endunless -%}
                  {%- assign first_row = false -%}
                  {
                    "name": {{ shade_value | json }},
                    "variant": {{ variant.id }},
                    "available": {{ variant.available }},
                    "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %},
                    "imageId": {% if variant.featured_image %}{{ variant.featured_image.id }}{% else %}null{% endif %},
                    "thumb": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %}
                  }
                {%- endfor -%}
              ]
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>

    <script src="{{ 'design-shades.js' | asset_url }}" defer></script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Design page",
  "settings": [
    { "type": "url", "id": "book_url", "label": "Design book link" },
    { "type": "url", "id": "swatch_url", "label": "Swatch card link" },
    { "type": "range", "id": "shade_columns", "label": "Shade columns", "min": 4, "max": 8, "step": 1, "default": 6 }
  ]
}
{% endschema %}
